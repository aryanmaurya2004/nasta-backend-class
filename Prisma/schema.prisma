generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  address   String?
  otp       String?
otpcreatedat DateTime? 
Menu Menu[] 
}



model Menu{
  id Int @id @default(autoincrement())
  name String
  description String
  Price_half Int
  Price_full Int
  thumnail String?
  user User @relation(fields: [created_by], references: [id])
  created_by Int
  created_at DateTime @default(now())
}